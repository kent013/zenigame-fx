def _f5_compute_all(ctx: EvaluationContext) -> np.ndarray:
    _, h, low, c = _bars_to_mid_ohlc(ctx.bars)
    short_n = _get_int_param(ctx.params, "short_n")
    long_n = _get_int_param(ctx.params, "long_n")
    k = _get_float_param(ctx.params, "k")
    if short_n >= long_n:
