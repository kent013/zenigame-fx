   115	def rolling_max(values: np.ndarray, n: int) -> np.ndarray:
   116	    """Monotonic deque による O(N) rolling max。warmup (i<n-1) は NaN。
   117	
   118	    Numba JIT 化 (T088 cycle 1 profile-optimize): collections.deque を fixed-size
   119	    int64 circular buffer (head/tail インデックス) に置換。 現行 comparator
   120	    (`<=` で右から drop) をそのまま再現、 数値出力は現行と numerically identical。
   121	    """
   122	    if n <= 0:
   123	        raise ValueError(f"n must be >= 1, got {n}")
   124	    values = np.asarray(values, dtype=np.float64)
   125	    return _rolling_max_jit(values, n)
