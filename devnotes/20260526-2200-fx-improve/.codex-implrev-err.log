   127	
   128	@numba.njit(cache=True, fastmath=False)
   129	def _rolling_max_jit(values: np.ndarray, n: int) -> np.ndarray:
   130	    length = values.shape[0]
   131	    out = np.full(length, np.nan, dtype=np.float64)
   132	    # circular buffer: 最大 n 個保持 (window 外を drop するので n より長くならない)
   133	    dq = np.empty(n, dtype=np.int64)
   134	    head = 0  # buffer の先頭 index (front)
   135	    tail = 0  # buffer の末尾 index (back exclusive)
   136	    size = 0
   137	    for i in range(length):
   138	        # window 外を front から drop
   139	        while size > 0 and dq[head] <= i - n:
   140	            head = (head + 1) % n
   141	            size -= 1
   142	        # 小さい値を back から drop (strict: <= で drop = 等値も drop = 現行と一致)
   143	        while size > 0:
   144	            back_idx = (tail - 1 + n) % n
   145	            if values[dq[back_idx]] <= values[i]:
   146	                tail = back_idx
   147	                size -= 1
   148	            else:
   149	                break
   150	        # back に追加
   151	        dq[tail] = i
   152	        tail = (tail + 1) % n
   153	        size += 1
   154	        if i >= n - 1:
   155	            out[i] = values[dq[head]]
   156	    return out
   157	
