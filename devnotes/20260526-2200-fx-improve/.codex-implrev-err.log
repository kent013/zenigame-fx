    62	def rolling_sum(values: np.ndarray, n: int) -> np.ndarray:
    63	    """長さ n の過去方向 rolling sum を返す。warmup 部 (i < n-1) は NaN。
    64	
    65	    O(N) 実装: `cumsum[i] - cumsum[i-n]`。
    66	    入力に NaN を含まない前提（呼び出し側で事前処理）。
    67	    """
    68	    if n <= 0:
    69	        raise ValueError(f"n must be >= 1, got {n}")
    70	    values = np.asarray(values, dtype=np.float64)
    71	    length = len(values)
    72	    out = np.full(length, np.nan, dtype=np.float64)
    73	    if length < n:
    74	        return out
    75	    cs = np.cumsum(values)
    76	    out[n - 1] = cs[n - 1]
    77	    if length > n:
    78	        out[n:] = cs[n:] - cs[:-n]
    79	    return out
    80	
