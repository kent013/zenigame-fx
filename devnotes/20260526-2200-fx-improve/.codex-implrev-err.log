   107	def _f1_compute_all(ctx: EvaluationContext) -> np.ndarray:
   108	    _, h, low, c = _bars_to_mid_ohlc(ctx.bars)
   109	    fast_n = _get_int_param(ctx.params, "fast_n")
   110	    slow_n = _get_int_param(ctx.params, "slow_n")
   111	    atr_n = _get_int_param(ctx.params, "atr_n")
   112	    ef = ema(c, fast_n)
   113	    es = ema(c, slow_n)
   114	    a = atr(h, low, c, atr_n)
   115	    raw = (ef - es) / (a + _EPS)
   116	    out = np.tanh(raw)
   117	    # warmup を明示的に NaN にする: ef/es/a のいずれかが NaN の index
   118	    mask = np.isnan(ef) | np.isnan(es) | np.isnan(a)
   119	    out = np.where(mask, np.nan, out)
   120	    return out
