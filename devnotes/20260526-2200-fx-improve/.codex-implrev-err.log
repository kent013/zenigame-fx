   702	    trend = np.full(n_bars, np.nan, dtype=np.float64)
   703	    ci = completed[use]
   704	    cv = htf_valid[ci]
   705	    rows = np.nonzero(use)[0][cv]
   706	    trend[rows] = np.tanh(htf_trend_raw[ci[cv]])
   707	
   708	    # LTF (M1) プルバック: ema/atr は recurrence で過去のみ参照
   709	    ema_ltf = ema(c, entry_n)
   710	    atr_ltf = atr(h, low, c, entry_n)
   711	    pullback = np.tanh((ema_ltf - c) / (k_entry * atr_ltf + _EPS))
   712	
   713	    align = np.maximum(0.0, trend * pullback)
   714	    res = trend * align
   715	    mask = np.isnan(trend) | np.isnan(ema_ltf) | np.isnan(atr_ltf)
   716	    out = np.where(mask, np.nan, res)
