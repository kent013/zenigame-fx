    33	def sigmoid(x: np.ndarray | float) -> np.ndarray | float:
    34	    """数値安定な logistic sigmoid: 1 / (1 + exp(-x))。
    35	
    36	    overflow を防ぐため `np.clip(x, -500, 500)` で抑える。
    37	    入力が float の場合は float、ndarray の場合は ndarray を返す
