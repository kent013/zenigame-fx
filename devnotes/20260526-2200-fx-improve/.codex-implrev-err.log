   198	def rolling_corr(x: np.ndarray, y: np.ndarray, n: int) -> np.ndarray:
   199	    """長さ n の過去方向 rolling Pearson 相関。warmup (i<n-1) は NaN。
   200	
   201	    O(N) 実装: Σx, Σy, Σxy, Σx², Σy² の 5 本 prefix-sum を差分更新し、
   202	    各 i で r = (n*Σxy - Σx*Σy) / sqrt((n*Σx² - (Σx)²)(n*Σy² - (Σy)²))。
   203	    denom == 0 は NaN。
   204	    """
   205	    x = np.asarray(x, dtype=np.float64)
   206	    y = np.asarray(y, dtype=np.float64)
   207	    if len(x) != len(y):
   208	        raise ValueError("x and y must have the same length")
   209	    sx = rolling_sum(x, n)
   210	    sy = rolling_sum(y, n)
   211	    sxx = rolling_sum(x * x, n)
   212	    syy = rolling_sum(y * y, n)
   213	    sxy = rolling_sum(x * y, n)
   214	    num = n * sxy - sx * sy
   215	    denx = np.maximum(n * sxx - sx * sx, 0.0)
   216	    deny = np.maximum(n * syy - sy * sy, 0.0)
   217	    denom = np.sqrt(denx * deny)
   218	    with np.errstate(divide="ignore", invalid="ignore"):
   219	        out = np.where(denom > 0, num / denom, np.nan)
   220	    # np.where は broadcasting 済み ndarray を返すため、入力が float の場合も ndarray
   221	    # 出力を clip して numerical noise で [-1, +1] を僅かに超えるケースを抑える
   222	    out = np.clip(out, -1.0, 1.0)
   223	    # NaN は clip で保持されない場合があるため mask 戻し
   224	    out = np.where(np.isnan(denom), np.nan, out)
   225	    return out
