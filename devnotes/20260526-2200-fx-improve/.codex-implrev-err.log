   233	def ema(values: np.ndarray, n: int) -> np.ndarray:
   234	    """指数移動平均。seed は最初の n 個の SMA、α = 2/(n+1)。
   235	
   236	    warmup: out[i<n-1] = NaN。
   237	    """
   238	    if n <= 0:
   239	        raise ValueError(f"n must be >= 1, got {n}")
   240	    values = np.asarray(values, dtype=np.float64)
   241	    length = len(values)
   242	    out = np.full(length, np.nan, dtype=np.float64)
   243	    if length < n:
   244	        return out
   245	    alpha = 2.0 / (n + 1.0)
   246	    seed = float(values[:n].mean())
   247	    out[n - 1] = seed
   248	    prev = seed
   249	    for i in range(n, length):
   250	        cur = alpha * values[i] + (1.0 - alpha) * prev
   251	        out[i] = cur
   252	        prev = cur
   253	    return out
   254	
