    83	    for _ in range(n):
    84	        prices.append(prices[-1] + rng.normal(0, volatility))
    85	    bars: list[PriceBar] = []
    86	    for i in range(n):
    87	        o = prices[i]
    88	        c = prices[i + 1]
    89	        hi = max(o, c) + abs(rng.normal(0, 0.1))
    90	        lo = min(o, c) - abs(rng.normal(0, 0.1))
    91	        ohlc = Ohlc(
    92	            open=Decimal(str(o)),
    93	            high=Decimal(str(hi)),
    94	            low=Decimal(str(lo)),
    95	            close=Decimal(str(c)),
    96	        )
    97	        bars.append(
    98	            PriceBar(
    99	                pair_name="EUR_USD",
   100	                bar_time=base_time + step * i,
   101	                bid=ohlc,
   102	                ask=ohlc,
   103	                volume=1000,
   104	                complete=True,
   105	            )
   106	        )
   107	    return bars
