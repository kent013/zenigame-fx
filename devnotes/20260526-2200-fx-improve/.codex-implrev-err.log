    92	def rolling_std(values: np.ndarray, n: int, ddof: int = 0) -> np.ndarray:
    93	    """長さ n の過去方向 rolling 標準偏差 (population; ddof=0 default)。
    94	
    95	    O(N) 実装: `var = E[X²] - (E[X])²` を prefix-sum 2 本で算出。
    96	    numerical round-off で var が負になりうるため max(var, 0) でクランプ。
    97	    """
    98	    if n <= 1 and ddof >= n:
    99	        raise ValueError(f"n ({n}) must exceed ddof ({ddof})")
   100	    values = np.asarray(values, dtype=np.float64)
   101	    s = rolling_sum(values, n)
   102	    s2 = rolling_sum(values * values, n)
   103	    # var = E[X²] - (E[X])² (ddof=0) or (Σx² - (Σx)²/n) / (n - ddof) (ddof>0)
   104	    var = (
   105	        s2 / n - (s / n) ** 2
   106	        if ddof == 0
   107	        else (s2 - (s * s) / n) / (n - ddof)
   108	    )
   109	    var = np.maximum(var, 0.0)
   110	    out = np.sqrt(var)
   111	    # warmup NaN は s 経由で既に NaN
   112	    return out
