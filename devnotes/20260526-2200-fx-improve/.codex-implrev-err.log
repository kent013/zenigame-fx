   680	        # 完全に閉じた HTF bucket が無い → 全 bar neutral(NaN)
   681	        return out
   682	
   683	    # 各 bucket の HTF OHLC を集約 (open=最初, high=max, low=min, close=最後)。
   684	    end_excl = np.append(start_idx[1:], n_bars)  # 各 bucket の終端 (exclusive)
   685	    htf_open = o[start_idx]
   686	    htf_high = np.maximum.reduceat(h, start_idx)
   687	    htf_low = np.minimum.reduceat(low, start_idx)
   688	    htf_close = c[end_excl - 1]
   689	
   690	    # HTF 指標 (length = n_buckets)。atr の HTF 窓は trend_slow_n を流用 (最小実装)。
   691	    hf = ema(htf_close, trend_fast_n)
   692	    hs = ema(htf_close, trend_slow_n)
   693	    ha = atr(htf_high, htf_low, htf_close, trend_slow_n)
   694	    htf_trend_raw = (hf - hs) / (ha + _EPS)
   695	    htf_valid = ~(np.isnan(hf) | np.isnan(hs) | np.isnan(ha))
   696	
   697	    # 各 M1 bar の bucket 位置 → 直近確定 bucket (pos-1) の HTF 値を参照 (look-ahead 防止)
   698	    pos = np.searchsorted(uniq, bkt)  # bkt は uniq の要素ゆえ pos は bucket index
