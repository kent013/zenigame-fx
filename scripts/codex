#!/bin/sh
# codex: Launch Codex CLI using the executable bundled with the OpenAI ChatGPT VSCode extension.
# 保証しない範囲は scripts/README.md の「起動ラッパと状態表示行が保証しない範囲」に書いてある。

# --- i3: 実行環境は uname の答えから決める (ディレクトリ名の接尾辞は見ない) ---
uname_s=$(uname -s)
uname_m=$(uname -m)
case "$uname_s" in
  Linux)
    case "$uname_m" in
      aarch64|arm64) bin_rel="bin/linux-aarch64/codex" ;;
      x86_64|amd64)  bin_rel="bin/linux-x86_64/codex" ;;
      *) printf '%s\n' "Error: unsupported machine hardware name (uname -m = $uname_m, uname -s = $uname_s)." >&2
         exit 1 ;;
    esac
    ;;
  Darwin)
    case "$uname_m" in
      arm64|aarch64) bin_rel="bin/macos-aarch64/codex" ;;
      x86_64|amd64)  bin_rel="bin/macos-x86_64/codex" ;;
      *) printf '%s\n' "Error: unsupported machine hardware name (uname -m = $uname_m, uname -s = $uname_s)." >&2
         exit 1 ;;
    esac
    ;;
  *)
    printf '%s\n' "Error: unsupported operating system (uname -s = $uname_s, uname -m = $uname_m)." >&2
    exit 1
    ;;
esac

nl='
'

# --- i1 / i2: 2 つの置き場を順に見て、同梱物が実在する候補だけを採る ---
matched=0        # 名前の当たるディレクトリが 1 つ以上あったか (i4 の 2 状態の境目)
rejected=""      # 外した候補 (1 件 1 行)
best_name=""
best_bin=""
best_root=""
best_version=""

for ext_root in "$HOME/.vscode/extensions" "$HOME/.vscode-server/extensions"; do
  for ext_dir in "$ext_root"/openai.chatgpt-*; do
    [ -d "$ext_dir" ] || continue
    matched=1

    name=${ext_dir##*/}
    version=${name#openai.chatgpt-}
    version=${version%%-*}
    case "$version" in
      [0-9]*) ;;
      *) rejected="$rejected$ext_dir: not a readable version in the directory name$nl"
         continue ;;
    esac

    cand_bin="$ext_dir/$bin_rel"
    if [ ! -f "$cand_bin" ] || [ ! -x "$cand_bin" ]; then
      rejected="$rejected$ext_dir: no runnable binary for this platform ($bin_rel)$nl"
      continue
    fi

    if [ -z "$best_bin" ]; then
      best_name=$name; best_bin=$cand_bin; best_root=$ext_root; best_version=$version
      continue
    fi

    if [ "$version" = "$best_version" ]; then
      # 同じ版: 置き場が違えば先に見た置き場を保つ。同じ置き場ならバイト順で大きい方を採る。
      if [ "$best_root" = "$ext_root" ]; then
        sorted=$(printf '%s\n%s\n' "$best_name" "$name" | LC_ALL=C sort -r) || {
          printf '%s\n' "Error: cannot compare candidate directory names (sort failed)." >&2
          exit 1
        }
        if [ "${sorted%%"$nl"*}" = "$name" ]; then
          best_name=$name; best_bin=$cand_bin
        fi
      fi
      continue
    fi

    sorted=$(printf '%s\n%s\n' "$best_version" "$version" | sort -rV) || {
      printf '%s\n' "Error: cannot compare extension versions (sort -V failed)." >&2
      exit 1
    }
    if [ "${sorted%%"$nl"*}" = "$version" ]; then
      best_name=$name; best_bin=$cand_bin; best_root=$ext_root; best_version=$version
    fi
  done
done

# --- i5: 見つかったら exec で置き換える (引数も終了コードもそのまま) ---
if [ -n "$best_bin" ]; then
  exec "$best_bin" "$@"
fi

# --- i4: 見つからないときは標準出力は空・終了コード 1・理由は標準エラー出力へ ---
if [ "$matched" -eq 0 ]; then
  printf '%s\n' "Error: no OpenAI ChatGPT VSCode extension directory found." >&2
  printf '%s\n' "  searched: $HOME/.vscode/extensions/openai.chatgpt-*" >&2
  printf '%s\n' "  searched: $HOME/.vscode-server/extensions/openai.chatgpt-*" >&2
  printf '%s\n' "  hint: install the OpenAI ChatGPT extension from the VSCode marketplace." >&2
else
  printf '%s\n' "Error: extension directories were found but none has a runnable Codex binary." >&2
  printf '%s\n' "  required: <extension>/$bin_rel (uname -s = $uname_s, uname -m = $uname_m)" >&2
  printf '%s' "$rejected" >&2
fi
exit 1
